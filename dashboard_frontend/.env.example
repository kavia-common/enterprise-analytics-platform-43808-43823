# Frontend runtime configuration (Next.js)
# Provide these values via the deployment environment / .env (do not commit secrets).

# Base URL for REST API, e.g. "http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL=

# Base URL for WebSocket API, e.g. "ws://localhost:3001"
NEXT_PUBLIC_WS_BASE_URL=

# Public site URL used in redirects (future auth flows)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
